# SQLAlchemy URL. Defaults to sqlite:///<backend>/zoom.db when unset.
DATABASE_URL=sqlite:///./zoom.db
# Public URL of the frontend: used in invite links and allowed by CORS.
FRONTEND_URL=http://localhost:3000
# Optional extra CORS origins (comma-separated) and an optional origin regex,
# e.g. for Vercel preview deployments: https://zoom-clone-.*\.vercel\.app
CORS_ORIGINS=
CORS_ORIGIN_REGEX=
# Seconds an empty live meeting stays open before it is auto-ended.
EMPTY_MEETING_GRACE_SECONDS=60
# How long a login stays valid (days).
SESSION_TTL_DAYS=30
